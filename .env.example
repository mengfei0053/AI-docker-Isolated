# Copy to .env and choose the host directory exposed read/write as /projects.
# When unset, Compose uses ./workspace instead.
PROJECTS_DIR=./workspace
# Host SOCKS5 proxy used by proxy-gateway.
PROXY_HOST=host.docker.internal
PROXY_PORT=10810
# Agent Board host port; bound only to 127.0.0.1, container port stays 8791.
AGENT_BOARD_HOST_PORT=8792
